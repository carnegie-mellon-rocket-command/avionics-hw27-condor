	(text "Datasheet Rev. B: Table 5 (p.6), Fig.23 (p.15), Fig.31 (p.26)." (at 87.63 130.81 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5e7b72d9-a60b-475e-a971-13da4a60c352"))
	(text "VS = VDD: 2.0-3.6 V. VDD I/O = VDDIO: 1.7 V to VS." (at 87.63 135.89 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "99ccc2c6-9f7c-41fd-9565-b074a1bf222e"))
	(text "Place both decouplers at the supply pins; use low-impedance ground." (at 87.63 140.97 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8077334a-33e0-411a-8a77-206775a9e5f2"))
	(text "C3: select 1uF tantalum part, voltage rating and footprint before PCB layout." (at 87.63 146.05 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0b33d331-5702-48c0-a7ff-273bce309c51"))
	(text "SPI mode 3 (CPOL=1, CPHA=1), 5 MHz maximum. CS driven by MCU." (at 87.63 151.13 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8b08dddd-993a-456d-b76d-44bc4a59efae"))
	(text "Shared SPI bus: gate SDI with CS per Fig.24 unless bus traffic is controlled." (at 87.63 156.21 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "cb25fc6a-b722-48ef-a2e4-d3ec1a340187"))
	(text "Pins 3/11 reserved: intentionally open. Pin 10 NC: intentionally open." (at 87.63 161.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bd4a12b9-c7a4-433b-b97e-c61f932d6670"))
	(text "Mount near a rigid PCB mounting point; separate analog/digital supplies preferred." (at 87.63 166.37 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8c2f36c3-cfa8-40c6-bb83-461057265f69"))
